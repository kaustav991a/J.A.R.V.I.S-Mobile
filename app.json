{
  "expo": {
    "name": "JARVIS",
    "slug": "jarvis-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#020814",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mypersonalintelligence.jarvis"
    },
    "android": {
      "package": "com.mypersonalintelligence.jarvis",
      "adaptiveIcon": {
        "backgroundColor": "#020814",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-reactor.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#020814",
          "dark": {
            "image": "./assets/splash-reactor.png",
            "backgroundColor": "#020814"
          }
        }
      ],
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "f047fd2e-e0fd-4d50-a70c-564bfb1d6da6"
      }
    },
    "owner": "kaustav790"
  }
}
