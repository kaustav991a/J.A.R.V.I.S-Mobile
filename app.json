{
  "expo": {
    "name": "JARVIS",
    "slug": "jarvis-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "updates": {
      "url": "https://u.expo.dev/f047fd2e-e0fd-4d50-a70c-564bfb1d6da6",
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#020814",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mypersonalintelligence.jarvis"
    },
    "android": {
      "package": "com.mypersonalintelligence.jarvis",
      "adaptiveIcon": {
        "backgroundColor": "#020814",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.CAMERA",
        "android.permission.PACKAGE_USAGE_STATS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/withPackageQueries",
      "./plugins/withArm64Only",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-reactor.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#020814",
          "dark": {
            "image": "./assets/splash-reactor.png",
            "backgroundColor": "#020814"
          }
        }
      ],
      "expo-asset",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow JARVIS to unlock with Face ID."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#3ea6ff"
        }
      ],
      "expo-audio",
      "expo-background-task",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow JARVIS to take a photo to look at.",
          "photosPermission": "Allow JARVIS to open a photo for you to send."
        }
      ],
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow JARVIS to notice when you arrive at and leave your named places, so your timings are measured rather than guessed.",
          "isAndroidBackgroundLocationEnabled": true
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "f047fd2e-e0fd-4d50-a70c-564bfb1d6da6"
      }
    },
    "owner": "kaustav790"
  }
}
